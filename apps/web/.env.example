# Copy to .env.local and fill in. Never commit .env.local.
# Supabase (PKCE sign-in). Until B5 (free project + Google sign-in) is done,
# these stay empty and the pairing pages run in clearly-labeled DEMO-ONLY mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public origin used for the QR payload https://<site>/remote?pair=<CODE>.
# Defaults to window.location.origin when empty.
VITE_SITE_URL=

# DEMO-ONLY localStorage pairing fallback. '1' enables it, and only while
# Supabase is unconfigured. Remove this line entirely before release.
VITE_ROCKY_DEMO_PAIRING=1
